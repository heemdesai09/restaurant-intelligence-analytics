# MongoDB Connection URI
# For MongoDB Atlas:
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Target Database: sample_restaurants | Target Collection: restaurants
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# For Local MongoDB (standalone):
# MONGODB_URI=mongodb://localhost:27017

# Server Port (Render sets this dynamically; defaults to 8080 locally)
PORT=8080
